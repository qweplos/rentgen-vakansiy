{
  "manifest_version": 3,
  "name": "Рентген вакансий",
  "version": "0.2.0",
  "description": "Оценка вакансий на hh.ru по данным, которые сайт не показывает: конкуренция, настоящий возраст, зомби-вакансии, тестовые задания.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hh.ru/*",
        "https://*.hh.ru/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://hh.ru/*",
        "https://*.hh.ru/*"
      ],
      "js": [
        "src/score.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rentgen-vakansiy@qweplos",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "Рентген вакансий — настройки",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
